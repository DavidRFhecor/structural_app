{
  "form_key": "muro",
  "title": "Muro de Contención",
  "description": "Cálculo de estabilidad global y resistencia de la sección del muro.",
  "extended_info": "Cálculo según EHE-08 / EC2. Estabilidad por Coulomb con opción sísmica (Mononobe-Okabe). Comprobación de deslizamiento, vuelco y tensiones en terreno.",
  "references": [
    { "title": "EHE-08: Instrucción de Hormigón Estructural", "url": "https://www.mitma.gob.es" },
    { "title": "Eurocódigo 7: Proyecto Geotécnico", "url": "https://www.eurocode2.com" }
  ],
  "category": "Geotecnia / Estructuras",
  "norm_version": "ehe08_ec7",
  "features": { "svg": true, "viewer_3d": false, "sketch": true },

  "tabs": [

    {
      "id": "tab_geometria",
      "label": "1. Geometría",
      "groups": [
        {
          "name": "1.1 Geometría del Muro",
          "layout_columns": 2,
          "fields": [
            { "id": "h_muro",        "label": "Altura sobre zapata, H",     "unit": "m",   "default": 6.5,  "min": 0.5,  "max": 30.0, "step": 0.1 },
            { "id": "e_coronacion",  "label": "Ancho en coronación, e",      "unit": "m",   "default": 0.5,  "min": 0.2,  "max": 2.0,  "step": 0.05 },
            { "id": "incl_trasdos",  "label": "Inclinación trasdós (1H/xV)", "unit": "—",   "default": 100000.0, "min": 1.0, "step": 1.0 },
            { "id": "long_alzado",   "label": "Longitud alzado",             "unit": "m",   "default": 1.0,  "min": 0.1,  "step": 0.5 }
          ]
        },
        {
          "name": "1.1 Geometría de la Zapata",
          "layout_columns": 2,
          "fields": [
            { "id": "puntera",       "label": "Puntera",                     "unit": "m",   "default": 1.5,  "min": 0.0,  "step": 0.1 },
            { "id": "talon",         "label": "Talón",                       "unit": "m",   "default": 3.0,  "min": 0.0,  "step": 0.1 },
            { "id": "canto_min_zap", "label": "Canto mínimo zapata, Cmin",  "unit": "m",   "default": 1.0,  "min": 0.3,  "step": 0.05 },
            { "id": "canto_max_zap", "label": "Canto máximo zapata, Cmax",  "unit": "m",   "default": 1.5,  "min": 0.3,  "step": 0.05 },
            { "id": "long_zapata",   "label": "Longitud zapata",             "unit": "m",   "default": 1.0,  "min": 0.1,  "step": 0.5 }
          ]
        }
      ]
    },

    {
      "id": "tab_relleno",
      "label": "2. Relleno y Terreno",
      "groups": [
        {
          "name": "1.2 Características del Relleno",
          "layout_columns": 2,
          "fields": [
            { "id": "gamma_relleno", "label": "Peso específico relleno, γ",  "unit": "kN/m³", "default": 18.0, "min": 10.0, "max": 24.0, "step": 0.5 },
            { "id": "phi_relleno",   "label": "Ángulo rozamiento interno, Ø","unit": "°",     "default": 27.0, "min": 10.0, "max": 45.0, "step": 1.0 },
            { "id": "delta_coulomb", "label": "Rozamiento muro-tierra, δ",   "unit": "°",     "default": 15.0, "min": 0.0,  "max": 30.0, "step": 1.0 },
            { "id": "beta_relleno",  "label": "Inclinación superficie, β",   "unit": "°",     "default": 0.0,  "min": 0.0,  "max": 30.0, "step": 1.0 },
            { "id": "sc",            "label": "Sobrecarga superficial, sc",  "unit": "kN/m²", "default": 10.0, "min": 0.0,  "step": 1.0 }
          ]
        },
        {
          "name": "1.3 Características del Terreno de Apoyo",
          "layout_columns": 2,
          "fields": [
            { "id": "sigma_adm_est", "label": "Tensión admisible estática",  "unit": "kg/cm²","default": 2.0,  "min": 0.5,  "step": 0.5 },
            { "id": "sigma_adm_sis", "label": "Tensión admisible sísmica",   "unit": "kg/cm²","default": 3.0,  "min": 0.5,  "step": 0.5 },
            { "id": "pct_comprimido","label": "% mínimo zapata comprimida",  "unit": "%",     "default": 75.0, "min": 0.0,  "max": 100.0,"step": 5.0 },
            { "id": "phi_terreno",   "label": "Ángulo rozamiento terreno, Ø","unit": "°",     "default": 30.0, "min": 10.0, "max": 45.0, "step": 1.0 }
          ]
        }
      ]
    },

    {
      "id": "tab_acciones",
      "label": "3. Acciones",
      "groups": [
        {
          "name": "1.4 Acciones en Cabeza del Muro",
          "layout_columns": 2,
          "fields": [
            { "id": "carga_h",   "label": "Carga horizontal",  "unit": "kN/m", "default": 0.0, "reference": "Positiva si desestabiliza" },
            { "id": "carga_v",   "label": "Carga vertical",    "unit": "kN/m", "default": 0.0, "reference": "Positiva si comprime" },
            { "id": "momento",   "label": "Momento",           "unit": "mkN/m","default": 0.0, "reference": "Positivo si desestabiliza" }
          ]
        },
        {
          "name": "1.5 Acciones Sísmicas",
          "layout_columns": 2,
          "fields": [
            { "id": "considerar_sismo",  "label": "Considerar sismo",             "type": "toggle", "default": false },
            { "id": "inercia_muro",      "label": "Considerar inercia del muro",  "type": "toggle", "default": true },
            { "id": "inercia_zapata",    "label": "Considerar inercia de zapata", "type": "toggle", "default": false },
            { "id": "ac_horizontal",     "label": "Aceleración horizontal, αh",   "unit": "g",  "default": 0.7,  "min": 0.0, "max": 2.0, "step": 0.05 },
            { "id": "ac_vertical",       "label": "Aceleración vertical, αv",     "unit": "g",  "default": 0.35, "min": 0.0, "max": 2.0, "step": 0.05 }
          ]
        },
        {
          "name": "1.6 Coeficientes de Mayoración",
          "layout_columns": 2,
          "fields": [
            { "id": "gamma_carga_est", "label": "Coef. mayoración estático, γ",  "unit": "—", "default": 1.5, "min": 1.0, "step": 0.05 },
            { "id": "gamma_carga_sis", "label": "Coef. mayoración sísmico, γ",   "unit": "—", "default": 1.0, "min": 1.0, "step": 0.05 },
            { "id": "psi_sc",          "label": "Coef. sobrecarga combinación",  "unit": "—", "default": 0.2, "min": 0.0, "max": 1.0, "step": 0.05 }
          ]
        },
        {
          "name": "1.7 Coeficientes de Seguridad",
          "layout_columns": 2,
          "fields": [
            { "id": "fs_desliz_est", "label": "FS deslizamiento estático",  "unit": "—", "default": 1.5,   "min": 1.0, "step": 0.05, "reference": "EC7 §6.5.3" },
            { "id": "fs_desliz_sis", "label": "FS deslizamiento sísmico",   "unit": "—", "default": 1.1,   "min": 1.0, "step": 0.05 },
            { "id": "fs_vuelco_est", "label": "FS vuelco estático",         "unit": "—", "default": 1.8,   "min": 1.0, "step": 0.05, "reference": "EC7 §6.5.4" },
            { "id": "fs_vuelco_sis", "label": "FS vuelco sísmico",          "unit": "—", "default": 1.265, "min": 1.0, "step": 0.05 }
          ]
        }
      ]
    },

    {
      "id": "tab_materiales",
      "label": "4. Materiales",
      "groups": [
        {
          "name": "1.8 Materiales",
          "layout_columns": 2,
          "fields": [
            {
              "id": "hormigon", "label": "Hormigón", "type": "select", "default": "HA-25",
              "options": [
                {"value": "HA-20", "label": "HA-20", "fck": 20},
                {"value": "HA-25", "label": "HA-25", "fck": 25},
                {"value": "HA-30", "label": "HA-30", "fck": 30},
                {"value": "HA-35", "label": "HA-35", "fck": 35},
                {"value": "HA-40", "label": "HA-40", "fck": 40},
                {"value": "HA-45", "label": "HA-45", "fck": 45},
                {"value": "HA-50", "label": "HA-50", "fck": 50}
              ]
            },
            {
              "id": "acero", "label": "Acero", "type": "select", "default": "B 500 S",
              "options": [
                {"value": "B 400 S", "label": "B 400 S", "fyk": 400},
                {"value": "B 500 S", "label": "B 500 S", "fyk": 500},
                {"value": "B 500 T", "label": "B 500 T", "fyk": 500},
                {"value": "B 600 S", "label": "B 600 S", "fyk": 600}
              ]
            },
            { "id": "fck",  "label": "fck",  "unit": "MPa", "type": "derived", "formula": "fck_from_select", "depends_on": ["hormigon"] },
            { "id": "fcd",  "label": "fcd",  "unit": "MPa", "type": "derived", "formula": "fck / 1.5",       "depends_on": ["hormigon"] },
            { "id": "fyk",  "label": "fyk",  "unit": "MPa", "type": "derived", "formula": "fyk_from_select", "depends_on": ["acero"] },
            { "id": "fyd",  "label": "fyd",  "unit": "MPa", "type": "derived", "formula": "fyk / 1.15",      "depends_on": ["acero"] }
          ]
        },
        {
          "name": "2. Comprobación de Estabilidad — Parámetros Coulomb",
          "layout_columns": 2,
          "fields": [
            { "id": "coulomb_d", "label": "Ángulo rozamiento δ (Coulomb)", "unit": "°", "default": 15.0, "min": 0.0, "max": 30.0, "step": 1.0 },
            { "id": "coulomb_a", "label": "Inclinación trasdós α (Coulomb)","unit": "°", "default": 0.0,  "min": 0.0, "max": 45.0, "step": 1.0 }
          ]
        }
      ]
    }
  ]
}