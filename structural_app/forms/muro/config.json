    {
      "title": "EHE-08: Instrucción de Hormigón Estructural",
      "url": "https://www.mitma.gob.es"
    },
    {
      "title": "Eurocódigo 7: Proyecto Geotécnico",
      "url": "https://www.eurocode2.com"
    }
  ],
